# OpenTofu state / plans (generated under the work dir on the host)
*.tfstate
*.tfstate.*
.terraform/
*.tfplan

# Generated artifacts
*.iso
agent.x86_64.iso

# Secrets — never commit
openshift-pull-secret*
*_rsa
*_rsa.pub
*.key
auth/
kubeconfig
*kubeconfig*

# Coverage reports (generated by callback_plugins/coverage_reporter.py)
coverage.xml
.mock-coverage.xml
.mock-host-coverage.xml

# Python bytecode (callback_plugins/)
__pycache__/
*.pyc

# Ansible local cache
.ansible/

# Editor / OS
*.swp
.DS_Store
