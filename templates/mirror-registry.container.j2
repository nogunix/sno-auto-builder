# Quadlet unit for the SNO mirror registry, rendered by
# tasks/mirror-registry.yml into /etc/containers/systemd/ on the bastion.
# systemd generates sno-mirror-registry.service from this at daemon-reload.
[Unit]
Description=SNO mirror registry ({{ sno_cluster_name }}.{{ sno_base_domain }})
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=sno-mirror-registry
Image={{ sno_mirror_registry_image }}
# Published on {{ sno_mirror_registry_port }} because HAProxy already owns 443
# on this host (see helper_node.sh.j2).
PublishPort={{ sno_mirror_registry_port }}:5000
Volume={{ sno_mirror_registry_dir }}/data:/var/lib/registry:Z
Volume={{ sno_mirror_registry_dir }}/certs:/certs:ro,Z
Volume={{ sno_mirror_registry_dir }}/auth:/auth:ro,Z
Environment=REGISTRY_HTTP_ADDR=0.0.0.0:5000
Environment=REGISTRY_HTTP_TLS_CERTIFICATE=/certs/registry.crt
Environment=REGISTRY_HTTP_TLS_KEY=/certs/registry.key
Environment=REGISTRY_AUTH=htpasswd
Environment=REGISTRY_AUTH_HTPASSWD_REALM=Registry
Environment=REGISTRY_AUTH_HTPASSWD_PATH=/auth/htpasswd
# oc-mirror re-pushes on every run; without delete enabled the storage only
# ever grows.
Environment=REGISTRY_STORAGE_DELETE_ENABLED=true

[Service]
Restart=always
# The first start has to pull the registry image itself.
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
