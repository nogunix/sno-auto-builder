# Host-based HTTP reverse proxy for OpenShift clusters
# Managed by 03-expose-console.yml — removed by 99-destroy-all.yml
# Routes plain HTTP traffic (port 80) based on the Host header, complementing
# the SNI-based stream proxy that handles TLS (443) and API (6443).
#
# Port 80 used to be a raw TCP (stream) proxy. The settings below undo the
# http-proxy defaults that would otherwise make it behave differently: no
# 1 MB request body cap, HTTP/1.1 + Upgrade so WebSockets keep working,
# no buffering, and the stream module's 10 minute idle timeout.

map $http_upgrade $sno_connection_upgrade {
    default    upgrade;
    ''         '';
}

client_max_body_size 0;
proxy_http_version 1.1;
proxy_buffering off;
proxy_request_buffering off;
proxy_read_timeout 10m;
proxy_send_timeout 10m;
proxy_set_header Host $host;
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $sno_connection_upgrade;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

{% for b in sno_all_backends %}
server {
    listen 80;
    server_name *.{{ b.apps_domain }};

    location / {
        proxy_pass http://{{ b.ingress_vip }}:80;
    }
}

{% endfor %}
server {
    listen 80 default_server;

    location / {
        proxy_pass http://{{ sno_all_backends[0].ingress_vip }}:80;
    }
}
