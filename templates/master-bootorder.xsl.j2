<?xml version="1.0"?>
<!-- Rendered by 02-create-sno-cluster.yml for sno_master_layout: baremetal.
     Per-device boot order: the rootDeviceHints disk first, then the agent ISO.
     Legacy BIOS "boot dev=hd" only tries the FIRST disk, which here is a data
     disk on purpose; the node then falls through to the ISO after the
     install reboot and starts the whole install again (seen live). The
     provider (0.8.3) has no per-disk boot order, hence XSLT. -->
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
  <xsl:output omit-xml-declaration="yes" indent="yes"/>
  <xsl:template match="node()|@*">
    <xsl:copy><xsl:apply-templates select="node()|@*"/></xsl:copy>
  </xsl:template>
  <xsl:template match="/domain/os/boot"/>
  <xsl:template match="/domain/devices/disk[wwn='{{ sno_master_root_device_hints.wwn }}']">
    <xsl:copy>
      <xsl:apply-templates select="node()|@*"/>
      <boot order="1"/>
    </xsl:copy>
  </xsl:template>
  <xsl:template match="/domain/devices/disk[@device='cdrom']">
    <xsl:copy>
      <xsl:apply-templates select="node()|@*"/>
      <boot order="2"/>
    </xsl:copy>
  </xsl:template>
</xsl:stylesheet>
