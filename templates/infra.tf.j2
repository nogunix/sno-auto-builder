terraform {
  required_version = ">= 1.6"

  required_providers {
    libvirt = {
      source = "dmacvicar/libvirt"
      # Pinned exactly: 0.9.x is a plugin-framework rewrite with an incompatible
      # schema (devices/os nested blocks), so it is not a drop-in upgrade.
      version = "0.8.3"
    }
  }
}

provider "libvirt" {
  uri = "qemu:///system"
}

resource "libvirt_pool" "default" {
  name = "default"
  type = "dir"
  target {
    path = "{{ sno_pool_dir }}"
  }
}

resource "libvirt_network" "default_network" {
  name      = "default_network"
  autostart = true
  mode      = "nat"
  addresses = ["{{ sno_mgmt_network }}"]
  bridge    = "{{ sno_mgmt_bridge }}"
  dhcp {
    enabled = true
  }
}

{#  Disconnected: "none" is libvirt's isolated mode. The host keeps
    sno_gateway on the bridge, so it still reaches the VIPs and the node still
    has a next hop for its default route, but nothing is forwarded off the
    bridge. Under "nat" the node could reach quay.io directly, and a mirror
    missing an image would silently fall back to upstream instead of failing.
    The bastion is unaffected: its egress is the management NIC (metric 100). #}
resource "libvirt_network" "{{ sno_prefix }}_network" {
  name      = "{{ sno_prefix }}_network"
  autostart = true
  mode      = "{{ 'none' if sno_disconnected | bool else 'nat' }}"
  addresses = ["{{ sno_machine_network }}"]
  dhcp {
    enabled = false
  }
}
